# ---------------------------------------------------------------------------
# config/target.env
#
# Central configuration for the VAPT pipeline. Every script sources this
# file (via scripts/lib.sh) so there is exactly one place to change the
# target, ports, image tags, and output locations.
# ---------------------------------------------------------------------------

# --- Target application (OWASP Juice Shop) --------------------------------
TARGET_HOST="localhost"
TARGET_PORT="3000"
TARGET_URL="http://localhost:3000"

# Docker image + container name for the vulnerable target.
JUICE_SHOP_IMAGE="bkimminich/juice-shop"
JUICE_SHOP_IMAGE_TAG="latest"
JUICE_SHOP_CONTAINER="vapt-juice-shop"

# --- OWASP ZAP --------------------------------------------------------------
ZAP_IMAGE="ghcr.io/zaproxy/zaproxy:stable"
# "baseline" (fast, passive + light active) or "full" (slow, full active scan)
ZAP_SCAN_MODE="baseline"

# --- Credentials used for the auth-bypass / SQLi demo ----------------------
# Any valid-looking email works for the ' OR 1=1-- bypass; it is never a
# real account. This is intentionally the textbook Juice Shop PoC.
SQLI_BYPASS_EMAIL="' OR 1=1--"
SQLI_BYPASS_PASSWORD="whatever"

# Juice Shop login endpoint used throughout (auth-bypass, sqlmap, JWT capture).
LOGIN_ENDPOINT="${TARGET_URL}/rest/user/login"

# --- IDOR demo parameters ---------------------------------------------------
# Basket IDs to probe with the logged-in user's token to show that any
# basket ID is reachable regardless of ownership.
IDOR_BASKET_IDS="1 2 3 4 5"

# --- Output locations --------------------------------------------------------
RESULTS_DIR="results"
LOG_DIR="${RESULTS_DIR}/logs"
